# Copy to .env and fill in. Groq is the default provider (free key: https://console.groq.com).
LLM_API_KEY=gsk_your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# To use OpenRouter instead, swap the three values above, e.g.:
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Force the structured-JSON fallback loop instead of native tool-calling (0/1).
LLM_FORCE_JSON_MODE=0
